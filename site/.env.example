# Backend API
VITE_API_URL=https://api.philosify.org

# CDN for static assets (R2 bucket)
VITE_CDN_URL=https://pub-YOUR-BUCKET.r2.dev

# Supabase: NO frontend env needed — auth goes through backend HttpOnly
# cookies, and the Realtime client fetches its URL/anon key from
# GET /api/config at runtime (services/realtime.js).

# Feature Flags
VITE_ENABLE_GROK_MODEL=true
VITE_ENABLE_CLAUDE_MODEL=true

# Analytics (future)
VITE_GA_TRACKING_ID=
# Sentry error tracking (leave empty to disable; the DSN is inlined into the public bundle)
VITE_SENTRY_DSN=

# Environment
VITE_ENV=production
